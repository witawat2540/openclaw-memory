tell application "Notes"
    activate
    
    set targetNote to missing value
    repeat with aNote in notes
        if name of aNote starts with "# PROJECT NOVA - Issue Tracking" then
            try
                set test to body of aNote
                set targetNote to aNote
                exit repeat
            end try
        end if
    end repeat
    
    if targetNote is not missing value then
        set newBody to "<div># PROJECT NOVA - Issue Tracking</div><div><br></div><div>รายการงานจาก Google Sheet (อัปเดตล่าสุด: 2026-02-25 20:15)</div><div>โปรเจกต์: Board Game Nova</div><div><br></div><div>## 📋 รายการ Defect (ISSUES)</div><div><br></div><div>- [x] ✅ **DEFECT_001:** [Low] ฟอนต์เมนูบาร์ ไม่ได้ใช้ตัวหนา (NOT A DEFECT)</div><div>- [ ] ⭕️ **DEFECT_002:** [Low] ใช้เป็นภาษาอังกฤษในช่อง Search</div><div>- [x] ✅ **DEFECT_003:** [Low] คำว่า Reccommend ข้อความดีไซน์ต้องเป็นคำว่า Recommendation (✅ เสร็จแล้ว 25/02)</div><div>- [x] ✅ **DEFECT_004:** [Low] ตัวแบนเนอร์ และรูปภาพส่วนที่เป็นมุมต้องโค้ง (✅ เสร็จแล้ว 25/02 - radius_16)</div><div>- [ ] ⭕️ **DEFECT_005:** [Low] การเว้นระยะห่างแต่ละไอเท็มบอร์ดเกม ไม่เป็นไปตามดีไซน์</div><div>- [ ] ⭕️ **DEFECT_006:** [Low] เช็คขนาดฟอนต์ของหัวข้อและคำอธิบาย ลองเทียบดูมันเล็กกว่าดีไซน์</div><div>- [x] ✅ **DEFECT_007:** [High] กด location category จากหน้า Home ต้องไปหน้า location list (DONE)</div><div>- [ ] ⭕️ **DEFECT_008:** [Medium] Recommend บางข้อมูล เช่น review ,star ยัง Fix อยู่</div><div>- [ ] ⭕️ **DEFECT_009:** [Medium] item Recommend แต่ละรายการมีความสูง และช่องว่างที่มากเกินไป</div><div>- [ ] ⭕️ **DEFECT_010:** [Medium] item GM/GN แต่ละรายการมีการซ้อนทับกันของข้อมูล</div><div>- [ ] ⭕️ **DEFECT_011:** [Medium] item GM/GN ต้องเลื่อนในแบบแนวนอน</div><div>- [ ] ⭕️ **DEFECT_012:** [Medium] item Location ต้องแสดงแค่ 3 รายการ</div><div>- [ ] ⭕️ **DEFECT_013:** [Medium] Event Near me UI ไม่ตรง Figma</div><div>- [x] ✅ **DEFECT_014:** [High] ปิด tab bar เพื่อส่ง review ให้ผ่าน (DONE)</div><div>- [x] ✅ **DEFECT_015:** [High] ยิง api bookings แล้ว error ไปต่อหน้า checkout ไม่ได้ (DONE)</div><div>- [ ] ⭕️ **DEFECT_016:** [High] รูปภาพยังไม่ส่งมาใน api (**⚠️ กลับมาเป็น NOT FIXED** - ต้องตรวจสอบใหม่)</div><div>- [x] ✅ **DEFECT_017:** [High] ปิด favorite button เพื่อส่ง review ให้ผ่านก่อน (DONE)</div><div>- [x] ✅ **DEFECT_018:** [High] ปิด icon favorite และ message ออก เพื่อส่ง Review (DONE)</div><div>- [ ] ⭕️ **DEFECT_019:** [Low] font Robot Crush ปรับเป็นตัวพิมพ์เล็กให้หมด</div><div>- [ ] ⭕️ **DEFECT_020:** [High] หน้า profile ให้มีเมนู Delete account (เปิด website https://boardgamenova.com/#/support-center ในแอป)</div><div>- [x] ✅ **DEFECT_021:** [High] ปิดปุ่ม setting ไว้ เพื่อส่ง Review (DONE)</div><div>- [x] ✅ **DEFECT_022:** [Low] ต้องแสดง Eng ทั้งหมด และทำรองรับทั้ง 2 ภาษา (✅ เสร็จส่วน Localization Key)</div><div>- [ ] ⭕️ **DEFECT_023:** [Low] เพิ่มเมนูเปลี่ยนภาษา</div><div>- [ ] ⭕️ **DEFECT_024:** [Medium] หน้า search ที่มาจาก category จะไม่มีข้อมูลใน tab อื่น</div><div>- [x] ✅ **DEFECT_025:** [High] location list page ไม่มี banner (DONE)</div><div>- [ ] ⭕️ **DEFECT_026:** [Low] ปรับให้ ระยะ distance มีทศนิยม 1 ตำแหน่ง</div><div>- [x] ✅ **DEFECT_027:** [High] ปิดหน้า map ไปก่อน เพื่อส่ง review (DONE)</div><div>- [x] ✅ **DEFECT_028:** [High] ปิดส่วน payment เพื่อส่ง review (DONE)</div><div>- [x] ✅ **DEFECT_029:** [High] แก้ไขคำว่า Payment success เป็น Booking success (DONE)</div><div>- [x] ✅ **DEFECT_030:** [High] ข้อมูลร้านที่จองต้องเป็นร้านที่เลือก (DONE)</div><div><br></div><div>## 🆕 รายการใหม่ (ยังไม่มีหมายเลข DEFECT)</div><div><br></div><div>- [x] ✅ **Register Flow:** กด register แล้วกด next ไม่ได้ (DONE)</div><div>- [x] ✅ **Register Success:** กด get started แล้วไปต่อไม่ได้ (DONE)</div><div>- [x] ✅ **Homepage Point:** ปิด point ด้านบนขวา (DONE)</div><div>- [ ] ⭕️ **Gaming Sports Title:** กด Title แล้วไม่ไปหน้า location list</div><div>- [ ] ⭕️ **Event Join:** กด join event แล้วกดซ้ำได้ (ต้องกดซ้ำไม่ได้)</div><div>- [ ] ⭕️ **Search Filter:** ค้นหาแล้วข้อมูลที่ filter ไม่ตรง</div><div>- [ ] ⭕️ **Search Tab Load:** Tab อื่นมีแค่ 3 item ต้องโหลดเพิ่มได้</div><div>- [x] ✅ **Password Validator:** ใส่รหัสผิดไม่มีข้อความเตือน (DONE)</div><div>- [ ] ⭕️ **Term & Privacy:** เพิ่มหน้า Term and condition + Privacy policy</div><div>- [ ] ⭕️ **GM/GN Detail:** เพิ่มหน้า detail ของ GM/GN</div><div>- [ ] ⭕️ **Partner Detail:** เพิ่มหน้า detail ของ Partner</div><div>- [ ] ⭕️ **Profile Detail:** ข้อมูล profile ไม่ตรงกับที่ register</div><div><br></div><div>---</div><div><br></div><div>**📝 หมายเหตุ:**</div><div>- ✅ = เสร็จสิ้นแล้ว (DONE)</div><div>- ⭕️ = ยังค้างอยู่ (Pending)</div><div>- ⚠️ = กลับมาแก้ไขใหม่ (Re-open)</div><div>- อัปเดตล่าสุด: 2026-02-25 20:15</div><div>- โดย: Jarvis 🦾</div><div><br></div><div>*อัปเดตจาก Google Sheet ล่าสุด - DEFECT_016 กลับมาเป็น NOT FIXED*</div>"
        
        set body of targetNote to newBody
        return "อัปเดต Note สำเร็จ!"
    else
        return "ไม่พบ Note"
    end if
end tell
